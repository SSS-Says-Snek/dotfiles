return {
  "karb94/neoscroll.nvim",
  enable = false,
  config = function ()
    local neoscroll = require("neoscroll")

    neoscroll.setup({
      post_hook = function(info)
        if info ~= "center" then
          return
        end

        vim.defer_fn(function() neoscroll.zz(100, "sine") end, 10);
      end
    })

    local mappings = {}
    mappings["<C-u>"] = {"scroll", {"-vim.wo.scroll", "true", 200, "sine", "'center'"}}
    mappings["<C-d>"] = {"scroll", {"vim.wo.scroll", "true", 200, "sine", "'center'"}}

    require("neoscroll.config").set_mappings(mappings)
  end
}
